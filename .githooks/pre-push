#!/bin/sh
# push するコミット (追加行とメッセージ) に、個人に関わる内容が無いかを見る。
# このリポジトリは public で、push したものは PR の履歴から消せないので、ここが最後の歯止め。
root="$(git rev-parse --show-toplevel)" || exit 1
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # ブランチの削除
  if [ "$remote_sha" = "$zero" ]; then
    # 新しいブランチ: どのリモートにもまだ無いコミットだけを見る。
    range="$local_sha --not --remotes"
    commits="$(git rev-list $range)"
    [ -z "$commits" ] && continue
    first="$(echo "$commits" | tail -n 1)"
    if git rev-parse -q --verify "$first^" >/dev/null; then
      range="$first^..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  "$root/.githooks/_python" "$root/scripts/check_personal_info.py" --range "$range" || status=1
done
exit $status
