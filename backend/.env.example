# ---------------------------------------------------------------
# Project Penguin - backend 環境変数のテンプレート
#
# 使い方:
#   cp .env.example .env
#   .env に実際のキーを記入する
#
# .env は .gitignore で除外されています。
# public リポジトリのため、実キーを絶対にコミットしないでください。
# ---------------------------------------------------------------

# Gemini API キー (必須)
#   レシート画像の解析に使用します。
#   https://aistudio.google.com/apikey で取得。
GEMINI_API_KEY=

# ---------------------------------------------------------------
# 以下は任意。Gemini 以外のプロバイダを併用する場合のみ設定します。
# ---------------------------------------------------------------

# OpenRouter API キー (任意)
# OPENROUTER_API_KEY=

# 使用するプロバイダの切り替え (任意 / 既定: gemini)
# LLM_PROVIDER=gemini
