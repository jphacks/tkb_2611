# ---------------------------------------------------------------
# Unity
#   GitHub 公式テンプレート (github/gitignore の Unity.gitignore) に合わせる。
#   https://github.com/github/gitignore/blob/main/Unity.gitignore
# ---------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
# ログには実行中のデータが出うるためコミットしない。
*.log

# Blender の自動バックアップ (ArtSource/ の .blend を保存するたびにできる)
*.blend1
*.blend1.meta

# MemoryCaptures はサイズが大きく、実行中のデータをそのまま含む
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Burst が Web (WebGL) のビルドのたびにプロジェクト直下へ書き出す生成物
/Data/Plugins/lib_burst_generated*

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files (PlayMode テストのたびに作られる)
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# UI Toolkit auto generated files (UI Builder が作る UXML スキーマ)
/UIElementsSchema/

# Auto-generated cache in Assets folder
/[Aa]ssets/[Ss]ceneDependencyCache*

# ---------------------------------------------------------------
# IDE / エディタが自動生成するもの (Unity が毎回作り直すためコミットしない)
# ---------------------------------------------------------------
.vs/
.idea/
.vscode/
.gradle/
.consulo/
ExportedObj/
*.DotSettings.user
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------
# 秘密情報 (public リポジトリのため絶対にコミットしないこと)
#   API キーは FastAPI バックエンド側でのみ保持し、
#   Unity クライアントには一切埋め込まない設計。
# ---------------------------------------------------------------
.env
*.env
.env.*
!.env.example
!backend/.env.example
secrets.json
**/ApiKeys.cs
**/*.credentials*
*.pem
*.key

# Android の配布鍵。流出すると同じ鍵で偽アプリを署名できてしまい、
# 鍵を失うと Play 上の既存アプリを更新できなくなる。
*.keystore
*.jks

# iOS の署名証明書 (秘密鍵を含む) とプロビジョニングプロファイル。
*.p12
*.pfx
*.mobileprovision

# ---------------------------------------------------------------
# ローカルデータ
#   端末上の SQLite にはユーザーの購買履歴が入りうるため必ず除外する。
#   ※レシート画像・購買明細を扱う機構は、生データを端末外へ出さない
#     方針で実装すること (README「プライバシー方針」参照)。
# ---------------------------------------------------------------
#   WAL モードの -wal / -shm にも書き戻し前のデータがそのまま入るため、
#   本体と同じく除外する。
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# ---------------------------------------------------------------
# Python / FastAPI backend
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# ---------------------------------------------------------------
# Claude Code
#   CLAUDE.md / rules / hooks / settings.json はチームで共有し、
#   個人設定と実行時の生成物のみ除外する。
# ---------------------------------------------------------------
.claude/settings.local.json
.claude/*.local.*
.claude/hooks/__pycache__/
.agents/settings.local.json
.agents/*.local.*
CLAUDE.local.md

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# Local harness
/harness-v3/
/.local-tools/

# Local backups, recovery scenes and unreviewed captures
/Library_backup/
/Captures/
/Assets/_Recovery/
/Assets/_Recovery.meta

# IaC のデプロイ時のパラメータ (通知先のメールアドレスや Vercel のチーム名を含むので入れない)
infra/*.local.json
