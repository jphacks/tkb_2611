/* 建物の絵。Production Island > Render Facility Thumbnails が描き出した PNG を指す (このファイルもメニューが書き直す) */
.pp-thumb {
    -unity-background-scale-mode: scale-to-fit;
}

.pp-thumb--fishery {
    background-image: url("project://database/Assets/UI/Thumbnails/Thumb_Fishery.png");
}

