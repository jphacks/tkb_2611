/* カタログ画面専用のレイアウト。アプリ本体からは参照しない */

.catalog {
    flex-grow: 1;
    background-color: var(--color-ice-50);
}

.catalog .unity-scroll-view__content-container {
    padding: var(--space-6) var(--space-4) var(--space-8) var(--space-4);
}

.catalog__lead {
    margin-top: var(--space-1);
}

.catalog__section {
    margin: var(--space-6) 0 var(--space-2) 0;
}

.catalog__row {
    flex-direction: row;
    align-items: center;
}

.catalog__row--wrap {
    flex-wrap: wrap;
}

.catalog__item {
    margin: 0 var(--space-2) var(--space-2) 0;
}

.catalog__stack {
    margin-bottom: var(--space-2);
}

.catalog__stack-top {
    margin-top: var(--space-2);
}

.catalog__half {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-3);
}

.catalog__half--last {
    margin-right: 0;
}

.catalog__swatch {
    width: 180px;
    height: 120px;
    margin: 0 var(--space-2) var(--space-2) 0;
    padding: var(--space-1);
    justify-content: flex-end;
    border-radius: var(--radius-sm);
}

.catalog__swatch-label {
    font-size: var(--font-size-caption);
}

.catalog__swatch--primary { background-color: var(--color-primary); }
.catalog__swatch--primary-dark { background-color: var(--color-primary-dark); }
.catalog__swatch--ice-100 { background-color: var(--color-ice-100); }
.catalog__swatch--ice-50 { background-color: var(--color-ice-50); border-width: 2px; border-color: var(--color-ice-100); }
.catalog__swatch--eco { background-color: var(--color-eco); }
.catalog__swatch--accent { background-color: var(--color-accent); }
.catalog__swatch--point { background-color: var(--color-point); }
.catalog__swatch--danger { background-color: var(--color-danger); }
.catalog__swatch--text { background-color: var(--color-text); }
.catalog__swatch--text-sub { background-color: var(--color-text-sub); }

.catalog__tab-bar {
    margin-top: var(--space-7);
    border-radius: var(--radius-lg);
}
