/* 解析中画面のレイアウトだけを書く。見た目は DesignSystem のコンポーネントに任せる */

.analyzing__safe {
    flex-grow: 1;
}

.analyzing__top-bar {
    flex-direction: row;
    padding: var(--space-3) var(--space-4) 0 var(--space-4);
}

.analyzing__body {
    flex-grow: 1;
    padding: var(--space-4) var(--space-5);
}

.analyzing__receipt {
    align-items: center;
    padding: var(--space-6) var(--space-4);
}

.analyzing__badge {
    align-self: center;
    margin-top: var(--space-3);
}

.analyzing__caption {
    margin-top: var(--space-2);
}

.analyzing__steps {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-4);
}

.analyzing__penguin {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.analyzing__penguin-text {
    margin-top: var(--space-3);
}
