<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="AnalyzingScreen.uss" />
    <ui:VisualElement name="root" class="pp-page">
        <ui:VisualElement class="analyzing__safe pp-safe-area">
            <ui:VisualElement class="analyzing__top-bar">
                <ui:Button name="closeButton" class="pp-icon-button">
                    <ui:VisualElement class="pp-icon pp-icon--close pp-icon--sub" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement class="analyzing__body">
                <ui:VisualElement class="pp-card pp-elevated analyzing__receipt">
                    <ui:VisualElement class="pp-icon-badge">
                        <ui:VisualElement class="pp-icon pp-icon--lg pp-icon--camera pp-icon--primary" />
                    </ui:VisualElement>
                    <ui:Label text="解析中…" class="pp-badge analyzing__badge" />
                    <ui:Label name="analyzingCaption" text="写真を見ています" class="pp-text-sub pp-text-center analyzing__caption" />
                </ui:VisualElement>

                <ui:VisualElement name="steps" class="pp-card pp-elevated analyzing__steps">
                    <ui:VisualElement name="stepRead" class="pp-step">
                        <ui:VisualElement class="pp-step__index">
                            <ui:Label text="1" class="pp-step__number" />
                        </ui:VisualElement>
                        <ui:Label text="写真を受け取り中" class="pp-step__label" />
                        <ui:VisualElement class="pp-step__check pp-icon pp-icon--check pp-icon--eco" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stepClassify" class="pp-step">
                        <ui:VisualElement class="pp-step__index">
                            <ui:Label text="2" class="pp-step__number" />
                        </ui:VisualElement>
                        <ui:Label text="エコ活動を見分け中" class="pp-step__label" />
                        <ui:VisualElement class="pp-step__check pp-icon pp-icon--check pp-icon--eco" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stepCalculate" class="pp-step">
                        <ui:VisualElement class="pp-step__index">
                            <ui:Label text="3" class="pp-step__number" />
                        </ui:VisualElement>
                        <ui:Label text="島の資源に変えています" class="pp-step__label" />
                        <ui:VisualElement class="pp-step__check pp-icon pp-icon--check pp-icon--eco" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="analyzing__penguin" picking-mode="Ignore">
                    <ui:VisualElement class="pp-avatar">
                        <ui:VisualElement class="pp-avatar__image pp-icon pp-icon--penguin pp-icon--original" />
                    </ui:VisualElement>
                    <ui:Label text="少しだけ待ってね…" class="pp-text-bold pp-text-sub analyzing__penguin-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="pp-safe-area__bottom" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
