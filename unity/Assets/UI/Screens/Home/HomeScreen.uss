/* ホーム画面のレイアウトだけを書く。見た目は DesignSystem のコンポーネントに任せる */

.home {
    flex-grow: 1;
}

.home__safe {
    flex-grow: 1;
}

.home__header {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding: var(--space-3) var(--space-4) 0 var(--space-4);
}

/* 生産の島のレベルと資源。左に寄せ、設定ボタンは右端のまま */
.home__island-bar {
    flex-shrink: 1;
    margin-right: auto;
    transition-duration: var(--duration-fast);
}

.home__stats {
    flex-direction: row;
    padding: var(--space-2) var(--space-4) 0 var(--space-4);
}

.home__stat {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-3);
}

.home__stat--last {
    margin-right: 0;
}

.home__stat-note {
    margin-top: 2px;
}

.home__stat-note--danger {
    color: var(--color-danger);
    -unity-font-definition: var(--font-bold);
}

/* 3D ワールドが見える領域。タッチはワールド側へ透過させる */
.home__world {
    flex-grow: 1;
    padding: var(--space-2) var(--space-4) 0 var(--space-4);
}

/* 置き場所を選ぶ間の ✕ / ✓。島が見えるよう画面の下に寄せる */
.home__banner {
    position: absolute;
    right: 0;
    bottom: var(--space-2);
    left: 0;
    align-items: center;
}

.home__banner-costs {
    margin-bottom: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--color-surface-solid);
}

/* はじめての案内の間は、後ろの 3D の島だけを見せる */
.home--onboarding .home__safe {
    display: none;
}

/* 置き場所を選ぶ間は、島に集中できるよう吹き出しと道具を隠す */
.home--placing .home__speech,
.home--placing .home__tools,
.home--placing .home__demo {
    display: none;
}

.home__tools {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-2);
}

.home__speech {
    margin: 0 var(--space-8) var(--space-4) var(--space-4);
}

.home__speech-action {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-2);
}

.home__speech-action-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    margin-right: var(--space-1);
}

.home__speech-action-label {
    color: var(--color-primary);
    font-size: var(--font-size-caption);
    -unity-font-definition: var(--font-bold);
}

.home__gain-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.home__modal-body {
    align-self: stretch;
    margin-bottom: var(--space-3);
}

.home__quick-eco-list {
    height: 260px;
    flex-shrink: 1;
}

.home__quick-eco-card {
    white-space: normal;
    min-height: 64px;
    flex-shrink: 0;
    margin-bottom: var(--space-2);
}

.home__modal-cancel {
    margin-top: var(--space-2);
}

/* デモ用の操作。既定は隠し、開発ビルドだけ HomeStatusPresenter が表示する */
.home__demo {
    display: none;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: var(--space-2) var(--space-4) 0 var(--space-4);
}

.home__demo--visible {
    display: flex;
}

.home__demo-badge {
    margin: 0 var(--space-2) var(--space-1) 0;
}

.home__demo-button {
    margin: 0 var(--space-2) var(--space-1) 0;
}

.home__island-bar:active {
    scale: 0.97 0.97;
}

/* 資源の集め方のシート */
.island-guide__lead {
    white-space: normal;
    margin-bottom: var(--space-2);
}

.island-guide__today {
    margin-top: 2px;
    color: var(--color-primary);
}

.island-guide__amount {
    flex-shrink: 0;
    white-space: nowrap;
    margin-left: var(--space-2);
}
