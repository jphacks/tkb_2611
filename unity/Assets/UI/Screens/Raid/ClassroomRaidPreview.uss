.classroom { --classroom-sky: #6B8AAC; --classroom-snow: #F1F7FC; --classroom-white: #FFFFFF; --classroom-ink: #1D394E; background-color: var(--classroom-sky); color: var(--classroom-ink); font-size: 19px; }
.page-scroll { flex-grow: 1; }
.page-scroll .unity-scroll-view__content-container { flex-grow: 1; }
.page { width: 100%; max-width: 1000px; align-self: center; flex-grow: 1; min-height: 0; padding: 12px 20px 0; }
.badge { font-size: 15px; color: rgb(27,105,130); margin-bottom: 8px; white-space: normal; }
.title { font-size: 36px; -unity-font-style: bold; margin-bottom: 4px; }
.subtitle { font-size: 17px; color: rgb(70,102,119); margin-bottom: 12px; white-space: normal; }
.card { background-color: white; border-radius: 18px; padding: 20px 24px; margin-top: 14px; border-width: 1px; border-color: rgb(193,222,234); }
.heading { font-size: 23px; -unity-font-style: bold; white-space: normal; margin-bottom: 10px; }
.points { font-size: 30px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 8px; }
.rescue { width: 100%; height: 220px; flex-shrink: 0; }
.body { white-space: normal; margin: 8px 0; }
.note { font-size: 15px; color: rgb(78,106,122); white-space: normal; margin: 10px 0; }
.feedback { font-size: 17px; color: rgb(24,105,122); white-space: normal; margin: 12px 0; }
.row { flex-direction: row; flex-wrap: wrap; }
Button { min-height: 48px; white-space: normal; height: auto; padding: 10px 18px; margin: 5px 4px; border-radius: 12px; border-width: 1px; border-color: rgb(151,190,207); background-color: rgb(242,249,253); color: rgb(29,57,78); font-size: 19px; }
Button:hover { background-color: rgb(216,239,249); }
Button.primary { background-color: rgb(21,121,156); color: white; -unity-font-style: bold; }
Button.primary:hover { background-color: rgb(12,97,130); }
Button:disabled { opacity: 0.45; }
.options Button { margin-top: 8px; -unity-text-align: middle-left; }
.explanation { background-color: rgb(232,248,244); padding: 18px; border-radius: 12px; margin-top: 10px; }
IntegerField { font-size: 19px; margin: 8px 0; min-height: 36px; }
IntegerField > Label { min-width: 260px; }
ProgressBar { height: 26px; margin-bottom: 8px; }
ProgressBar .unity-progress-bar__progress { background-color: rgb(34,163,178); }
Foldout { margin-top: 8px; }
.success-message { white-space: normal; font-size: 21px; color: rgb(13,105,86); background-color: rgb(225,246,235); padding: 14px; border-radius: 10px; margin-bottom: 10px; }
.classroom.compact .page { padding: 14px 12px; }
.classroom.compact .title { font-size: 28px; white-space: normal; }
.classroom.compact .card { padding: 14px; margin-top: 12px; border-radius: 14px; }
.classroom.compact .heading { font-size: 20px; }
.classroom.compact .points { font-size: 26px; }
.classroom.compact .badge { font-size: 13px; }
.classroom.compact .subtitle { font-size: 16px; }
.classroom.compact .note { font-size: 14px; }
.classroom.compact Button { font-size: 18px; min-height: 52px; margin: 5px 0; padding: 10px 12px; }
.classroom.compact .row > Button { flex-grow: 1; }
.classroom.compact IntegerField { flex-direction: column; align-items: stretch; }
.classroom.compact IntegerField > Label { min-width: 0; margin-bottom: 6px; }
.classroom.compact IntegerField > .unity-base-field__input { min-height: 44px; }
.classroom.compact .explanation { padding: 12px; }
.classroom.compact .success-message { font-size: 19px; }
.classroom .page-scroll { min-height: 0; flex-shrink: 1; background-color: var(--classroom-snow); }
.classroom-landscape { flex-shrink: 0; }
.classroom-landscape .heading, .classroom-landscape .points, .classroom-landscape .body { color: var(--classroom-white); }
.classroom-landscape .heading { margin-bottom: 0; }
.classroom-landscape .points { font-size: 22px; margin: 4px 0; }
.classroom-landscape .body { font-size: 15px; margin: 2px 0 6px; }
.classroom-landscape .subtitle { display: none; }
.classroom-sheet { padding: 0 12px 12px; }
.classroom-reading .classroom-landscape .body { display: none; }
.classroom.compact .page { padding: 8px 8px 0; }
.classroom.compact .title { font-size: 23px; }
.classroom.compact .badge { margin-bottom: 2px; }
.classroom.compact .subtitle { margin-bottom: 4px; }
.classroom.compact .classroom-landscape .points { font-size: 20px; }
.classroom .page > .title, .classroom .page > .subtitle, .classroom .page > .badge { color: var(--classroom-white); }
