# ---------------------------------------------------------------
# 改行コードの正規化
#   リポジトリ内も作業ツリーも LF で統一する。
#   Windows / macOS を併用しても差分が出ず、.editorconfig の
#   end_of_line = lf、Unity YAML の eol=lf、ruff の出力とも一致する。
#   OS 依存に変換すると Windows だけ CRLF になり、整形ツールの出力と
#   git の変換が綱引きするため text=auto では止めない。
# ---------------------------------------------------------------
* text=auto eol=lf

*.cs        text eol=lf diff=csharp
*.md        text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.cginc     text eol=lf
*.uss       text eol=lf
*.uxml      text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf
.editorconfig text eol=lf

*.sh        text eol=lf
# Windows 専用スクリプトだけは CRLF でないと動かない場合がある。
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---------------------------------------------------------------
# Unity YAML アセットのマージドライバ
#   シーン / プレハブのコンフリクトを UnityYAMLMerge が構造的に解決する。
#   利用するには各自の .git/config への登録が必要 (README のセットアップ参照)。
#   未登録の環境では単に通常マージにフォールバックするため実害はない。
#   拡張子の一覧は .claude/hooks/guard_write.py の UNITY_YAML と .editorconfig にそろえる。
# ---------------------------------------------------------------
*.unity            merge=unityyaml eol=lf
*.prefab           merge=unityyaml eol=lf
*.asset            merge=unityyaml eol=lf
*.mat              merge=unityyaml eol=lf
*.anim             merge=unityyaml eol=lf
*.controller       merge=unityyaml eol=lf
*.overrideController merge=unityyaml eol=lf
*.physicMaterial   merge=unityyaml eol=lf
*.physicsMaterial2D merge=unityyaml eol=lf
*.meta             merge=unityyaml eol=lf
*.mask             merge=unityyaml eol=lf
*.playable         merge=unityyaml eol=lf
*.terrainlayer     merge=unityyaml eol=lf
*.signal           merge=unityyaml eol=lf
*.lighting         merge=unityyaml eol=lf
*.spriteatlas      merge=unityyaml eol=lf
*.spriteatlasv2    merge=unityyaml eol=lf
*.mixer            merge=unityyaml eol=lf
*.renderTexture    merge=unityyaml eol=lf
*.preset           merge=unityyaml eol=lf
*.giparams         merge=unityyaml eol=lf
*.shadervariants   merge=unityyaml eol=lf
*.guiskin          merge=unityyaml eol=lf
*.fontsettings     merge=unityyaml eol=lf
*.flare            merge=unityyaml eol=lf
*.brush            merge=unityyaml eol=lf
*.inputactions     text eol=lf

# ---------------------------------------------------------------
# バイナリ
#   3D モデル・テクスチャ・音声などは Git LFS を使わずに、そのまま入れる (docs/decisions.md)。
#   jphacks の org の LFS には実体が無く、clone した人がビルドできなくなるため。
#   改行の変換と差分・マージの対象から外す (binary)。
# ---------------------------------------------------------------
# 3D モデル
*.fbx   binary
*.FBX   binary
*.blend binary
*.obj   binary
*.dae   binary
*.3ds   binary
*.max   binary
*.ma    binary
*.mb    binary

# テクスチャ / 画像
*.png   binary
*.PNG   binary
*.jpg   binary
*.jpeg  binary
*.psd   binary
*.tga   binary
*.tif   binary
*.tiff  binary
*.bmp   binary
*.gif   binary
*.exr   binary
*.hdr   binary
*.cubemap binary

# 音声
*.wav   binary
*.mp3   binary
*.ogg   binary
*.aif   binary
*.aiff  binary

# 動画
*.mp4   binary
*.mov   binary
*.webm  binary

# その他バイナリ
*.unitypackage binary
*.dll   binary
*.so    binary
*.ttf   binary
*.otf   binary

# ---------------------------------------------------------------
# GitHub の言語集計 (Linguist)
#   外部から取り込んだコードを集計から外し、主言語を実態 (C#) に合わせる。
#   diff・マージ・LFS の扱いには影響しない。
#   https://github.com/github-linguist/linguist/blob/main/docs/overrides.md
# ---------------------------------------------------------------
# TextMesh Pro が自動で取り込んだシェーダとリソース (パスの空白は [[:space:]] で表す)
Assets/TextMesh[[:space:]]Pro/** linguist-vendored
# 外部のエージェント用スキル (skills-lock.json で管理)
.agents/skills/** linguist-vendored
.claude/skills/** linguist-vendored
